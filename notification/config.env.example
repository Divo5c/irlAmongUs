# Kopiere nach notification/config.env und fülle aus — diese Datei NICHT committen!
# Alternativ Env-Variablen setzen (haben Vorrang).

# ntfy.sh (empfohlen, kein Token nötig für public)
NTFY_TOPIC=my-spark-abc123xyz
NTFY_SERVER=https://ntfy.sh
#NTFY_USER=
#NTFY_PASS=
#NTFY_TOKEN=

# Alternative: generischer Webhook
#WEBHOOK_URL=https://example.com/webhook

# Alternative: Pushover
#PUSHOVER_TOKEN=
#PUSHOVER_USER=

# Alternative: Telegram
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Build: Public HTTPS server URL for the APK (required for beta builds)
#SERVER_URL=https://game.example.net

# Pfade (optional, falls nicht in PATH)
#FLUTTER_CMD=C:\src\flutter\bin\flutter.bat
#ADB_CMD=C:\platform-tools\adb.exe
